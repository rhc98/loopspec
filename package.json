{
  "name": "loopspec",
  "version": "0.1.0",
  "description": "Convergent sweep engine for bounded, auditable LLM automation over a YAML charter",
  "license": "MIT",
  "type": "module",
  "bin": {
    "loopspec": "src/cli/index.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "spike": "tsx spike/run.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fixtures:init": "tsx scripts/init-fixtures.ts",
    "validate": "tsx src/cli/index.ts validate",
    "run": "tsx src/cli/index.ts run",
    "stats": "tsx src/cli/index.ts stats"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "js-yaml": "^4.1.0",
    "execa": "^9.5.2",
    "commander": "^12.1.0",
    "vitest": "^2.1.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.7"
  }
}
